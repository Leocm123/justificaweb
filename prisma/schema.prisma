// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Funcionario {
  id   String @id @default(cuid())
  slug String @unique
  nome String
  ordem Int   @default(0)
}

model Justificativa {
  id    String @id @default(cuid())
  texto String @unique
  ordem Int    @default(0)
}

model Admin {
  id       String @id @default(cuid())
  email    String @unique
  password String
}
